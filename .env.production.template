# CareerIntel AI - Production Environment Template
# Copy this file to .env.production and fill in the values

# ============================
# Application
# ============================
APP_ENV=production
APP_NAME="Multi-Agent Career Intelligence System"
DEBUG=false

# ============================
# Database (PostgreSQL)
# ============================
POSTGRES_USER=careerintel
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=careerintel
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================
# Redis
# ============================
REDIS_URL=redis://redis:6379/0

# ============================
# Vector Database (Qdrant)
# ============================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ============================
# Frontend URL
# ============================
FRONTEND_URL=https://careerintel.ai

# ============================
# Security
# ============================
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================
# AI / LLM (OpenAI)
# ============================
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Other LLM providers
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# ============================
# External APIs (Optional)
# ============================
TAVILY_API_KEY=
SERPER_API_KEY=
NEWSAPI_KEY=
GITHUB_TOKEN=

# ============================
# Email (Notifications)
# ============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@careerintel.ai
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=noreply@careerintel.ai

# ============================
# Monitoring
# ============================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ============================
# File Upload
# ============================
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# ============================
# CORS
# ============================
CORS_ALLOW_ORIGINS=["https://careerintel.ai", "https://www.careerintel.ai"]
CORS_ALLOW_CREDENTIALS=true

# ============================
# SSL/TLS (Production)
# ============================
# Place SSL certificates in ./ssl/ directory:
# ./ssl/careerintel.crt
# ./ssl/careerintel.key