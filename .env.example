# ==========================================
# APPLICATION
# ==========================================
APP_NAME="Multi-Agent Career Intelligence System"
APP_ENV=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://careerintel:careerintel@localhost:5432/careerintel

# ==========================================
# AUTHENTICATION
# ==========================================
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ==========================================
# AI / LLM
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# EXTERNAL APIs (Optional - for production)
# ==========================================
TAVILY_API_KEY=
SERPER_API_KEY=
NEWSAPI_KEY=
GITHUB_TOKEN=

# ==========================================
# RESEARCH SETTINGS
# ==========================================
MAX_RESEARCH_SOURCES=10
RESEARCH_TIMEOUT_SECONDS=30
MAX_CONCURRENT_RESEARCH_TASKS=5

# ==========================================
# FILE UPLOAD
# ==========================================
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# ==========================================
# VECTOR DATABASE (Optional - for production)
# ==========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=careerintel

# ==========================================
# REDIS (Optional - for production workers)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# EMAIL (Optional - for notifications)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@careerintel.ai